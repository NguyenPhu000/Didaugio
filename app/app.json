{
  "expo": {
    "name": "iPoint Genie",
    "slug": "didaugio-app",
    "scheme": "didaugio",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#02030A"
    },
    "assetBundlePatterns": [
      "assets/fonts/*",
      "assets/brand/*",
      "assets/icon.png",
      "assets/splash.png",
      "assets/splash.mp4",
      "assets/sky.jpg",
      "assets/technical-support.png",
      "assets/ai/*"
    ],
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "iPoint Genie cần micro để bạn trò chuyện bằng giọng nói với Genie.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0077b8",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#02030A",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iPoint Genie cần vị trí để hiển thị địa điểm gần bạn."
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/fd70727b-495e-4344-a2c7-364931acfcdf",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "vn.ipointgenie.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#02030A",
      "barStyle": "light-content"
    },
    "ios": {
      "bundleIdentifier": "vn.ipointgenie.app",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["momo"],
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "iPoint Genie cần vị trí để hiển thị địa điểm gần bạn.",
        "NSMicrophoneUsageDescription": "iPoint Genie cần micro để bạn trò chuyện bằng giọng nói với Genie.",
        "NSPhotoLibraryUsageDescription": "iPoint Genie cần truy cập thư viện ảnh để bạn tải lên ảnh đại diện và bài viết.",
        "NSCameraUsageDescription": "iPoint Genie cần truy cập máy ảnh để bạn chụp hình trực tiếp."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd70727b-495e-4344-a2c7-364931acfcdf"
      }
    },
    "owner": "nguyenphu_000"
  }
}
