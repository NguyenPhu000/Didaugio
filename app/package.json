{
  "name": "ipointgenie-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go --port 8083",
    "dev": "expo start --dev-client --tunnel --port 8083",
    "android": "expo run:android --port 8083",
    "ios": "expo run:ios --port 8083",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:contract": "vitest run contract",
    "test:ai": "vitest run test/modules/ai",
    "test:map": "vitest run test/modules/map",
    "test:place": "vitest run test/modules/place",
    "test:booking": "vitest run test/modules/booking",
    "test:trips": "vitest run test/modules/trips",
    "test:stores": "vitest run test/stores test/constants test/lib",
    "test:routing-contract": "vitest run src/api/__tests__/routingApi.contract.test.js src/modules/map/hooks/__tests__/useMapRouting.mapping.contract.test.js",
    "validate:release-config": "node scripts/validate-release-config.cjs",
    "validate:native-config": "node scripts/validate-native-config.cjs",
    "eas-build-pre-install": "node scripts/validate-release-config.cjs && node scripts/validate-native-config.cjs",
    "maestro:explore": "maestro test maestro/explore-smoke.yaml",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "start:tunnel": "expo start --dev-client --tunnel --port 8083",
    "start:go": "expo start --go --tunnel --port 8083"
  },
  "dependencies": {
