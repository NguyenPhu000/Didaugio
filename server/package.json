{
  "name": "Didaugio API Server",
  "version": "1.0.0",
  "description": "server of project didaugio?",
  "keywords": [],
  "license": "ISC",
  "author": "Nguyen Hong Phu",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --exec babel-node src/server.js",
    "test": "node --import ./test/setupTestEnvironment.js --test test/**/*.test.js test/**/*.test.cjs",
    "test:unit": "node --import ./test/setupTestEnvironment.js --test test/unit/*.test.js test/unit/*.test.cjs",
    "test:contract": "node --import ./test/setupTestEnvironment.js --test test/contract/*.test.js",
    "test:integration": "node --import ./test/setupTestEnvironment.js --test test/integration/*.test.js",
    "test:e2e": "node --import ./test/setupTestEnvironment.js --test test/e2e/*.test.js",
    "test:multi-province": "node --test test/unit/twoTier*.test.js test/contract/twoTier*.test.js",
    "admin-data:audit": "node src/scripts/auditVietnamAdministrativeDataset.js",
    "admin-data:import": "node src/scripts/importVietnamAdministrativeDataset.js",
    "admin-location:backfill": "node src/scripts/backfillPlaceAdministrativeLocation.js",
    "admin-location:audit": "node src/scripts/auditPlaceAdministrativeLocation.js",
    "seed:cold-start": "node scripts/seedColdStart.js",
    "seed:financials": "node src/scripts/seedFinancialMockData.js",
    "studio": "prisma studio --schema=prisma/schema.prisma --port 5555",
    "migrate:push": "prisma migrate push --schema=prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "migrate:verify": "node src/scripts/verifyMigrationHistory.js",
    "quality:migrations": "npm run migrate:verify && node --test test/unit/migrationAudit.test.js test/contract/migrationHistory.contract.test.js test/integration/migrationReconciliation.integration.test.js test/integration/bookingIdempotencyMigration.integration.test.js",
    "quality:booking": "node --test test/unit/bookingPolicy.test.js test/unit/bookingIdempotency.test.js test/contract/bookingAvailability.contract.test.js test/contract/bookingAvailabilityRoute.contract.test.js test/unit/bookingTimeSlot.test.js test/integration/bookingAvailability.integration.test.js",
    "quality:payments": "node src/scripts/assertPaymentAuditDatabase.js && node --test test/unit/paymentCallbackObligation.test.js test/unit/vnpayCallbackNormalization.test.js test/unit/paymentCallbackHandler.test.js test/unit/paymentSePayBankWebhook.test.js test/unit/paymentSePayRefundWebhook.test.js test/contract/paymentMigration.contract.test.js test/integration/paymentMigration.integration.test.js test/unit/paymentTransition.test.js test/integration/manualPayment.integration.test.js test/unit/refundTransition.test.js test/integration/refundTransition.integration.test.js test/unit/bookingCancellationRefund.test.js test/contract/paymentRoute.contract.test.js test/unit/paymentQualityGate.test.js && npm --prefix ../app test -- src/modules/booking/api/paymentApi.test.js",
    "audit:booking:orphans": "node src/scripts/verifyBookingAuditCleanup.js",
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "trip:backfill": "node src/scripts/backfillTripPlans.js",
    "media:backfill-place-urls": "node src/scripts/backfillPlaceImageUrls.js",
    "media:remove-broken-place-images": "node src/scripts/removeBrokenPlaceImageReferences.js",
    "storage:remove-orphans": "node src/scripts/removeOrphanSensitiveFiles.js",
    "media:migrate-legacy-business-documents": "node src/scripts/migrateLegacyBusinessDocuments.js",
    "storage:audit": "node src/scripts/auditSensitiveStorage.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@turf/boolean-point-in-polygon": "^7.3.2",
    "@turf/helpers": "^7.3.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.6.2",
    "groq-sdk": "^0.18.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^6.1.0",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "zod": "^4.3.2",
    "zod-to-json-schema": "^3.25.1"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "form-data": "^4.0.6",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.16.0",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.5",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0"
  }
}
