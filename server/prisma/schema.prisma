// ==============================================================================
// DATABASE SCHEMA: didaugio_db (TỔNG CỘNG: 88 MODELS)
// Hệ sinh thái Du lịch Thông minh Cần Thơ (iPoint Genie)
// ------------------------------------------------------------------------------
// 1. Security & IAM (12 models):
//    Role, Permission, RolePermission, UserPermission, User, UserProfile,
//    UserSession, ActiveSession, EmailVerification, PasswordReset,
//    SensitiveDocument, StaffInvitation
// 2. Geography, Boundaries & PostGIS (10 models):
//    DistrictCantho, WardCantho, AdministrativeDatasetRelease, Province,
//    AdministrativeWard, ProvinceDatasetRecord, AdministrativeWardDatasetRecord,
//    PlaceAdministrativeLocationException, administrative_ward_boundaries,
//    province_boundaries
// 3. Place, Content, Tags & Telemetry (12 models):
//    Category, PlaceTag, TagGroup, CategoryTag, Place, PlaceTelemetry,
//    PlaceAiGuide, PlaceGuideFaq, PlaceImage, PlaceOpeningHour,
//    PlaceAmenity, PlaceTagLink
// 4. Social, Checkin & Community (7 models):
//    Review, ReviewMedia, ReviewReply, ReviewModerationLog, Favorite,
//    SavedTrip, UserCheckin
// 5. AI Engine, Chatbot Genie & Smart Travel (10 models):
//    AiConfig, AiConfigVersion, AiRequestLog, AiPromptHistory, TripPlan,
//    TripStop, BookingTripLink, TripExecutionSession, TripExecutionOperation,
//    CachedItinerary
// 6. Commerce, Booking & Financial Ledger (21 models):
//    Business, BusinessRole, BusinessService, BusinessBlockedDate,
//    PlaceResource, Voucher, AutoApproveRule, BookingActionLog, Booking,
//    BookingTransaction, Payment, PaymentReceipt, RefundAttempt,
//    PaymentWebhookLog, Payout, PartnerWallet, PlatformWallet, FinancialLedger,
//    SubscriptionPlan, Subscription, SubscriptionInvoice
// 7. Events, Marketing & System Operations (16 models):
//    Event, EventParticipant, EventMoment, DomainJob, TripShare, SystemConfig,
//    ApiKeyManagement, AuditLog, FeedbackReport, BannerMarketing,
//    NotificationGlobal, NotificationRecipient, PushSubscription,
//    SubscriptionStats, TripLegacyMap, spatial_ref_sys
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  displayName     String           @map("display_name")
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  isProtected     Boolean          @default(false) @map("is_protected")
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  displayName     String           @map("display_name")
  module          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  permissionId Int        @map("permission_id")
  grantedById  Int?       @map("granted_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  grantedBy    User?      @relation("GrantedPermissions", fields: [grantedById], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  password                String
  roleId                  Int                      @default(5) @map("role_id")
  status                  String                   @default("active")
  emailVerified           Boolean                  @default(false) @map("email_verified")
  lastLoginAt             DateTime?                @map("last_login_at")
  failedLoginCount        Int                      @default(0) @map("failed_login_count")
  lockedUntil             DateTime?                @map("locked_until")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")
  username                String                   @unique
  businessId              Int?                     @map("business_id")
  businessRoleId          Int?                     @map("business_role_id")
  activeSessions          ActiveSession[]
  aiConfigVersionsCreated AiConfigVersion[]        @relation("AiConfigVersionCreatedBy")
  aiConfigsUpdated        AiConfig[]               @relation("AiConfigUpdatedBy")
  aiPromptHistories       AiPromptHistory[]
  auditLogs               AuditLog[]
  banners                 BannerMarketing[]
  bookingActionLogs       BookingActionLog[]
  bookingTripLinksActor   BookingTripLink[]        @relation("BookingTripLinkActor")
  bookings                Booking[]
  blockedDatesCreated     BusinessBlockedDate[]    @relation("BlockedDateCreator")
  business                Business?                @relation("BusinessOwner")
  emailVerifications      EmailVerification[]
  eventMoments            EventMoment[]
  eventParticipations     EventParticipant[]
  createdEvents           Event[]                  @relation("EventCreator")
  favorites               Favorite[]
  feedbackReports         FeedbackReport[]         @relation("Reporter")
  resolvedReports         FeedbackReport[]         @relation("Resolver")
  notificationRecipients  NotificationRecipient[]
  notifications           NotificationGlobal[]
  passwordResets          PasswordReset[]
  paymentReceiptsActed    PaymentReceipt[]         @relation("PaymentReceiptActor")
  payments                Payment[]
  approvedPlaces          Place[]                  @relation("ApprovedBy")
  places                  Place[]                  @relation("CreatedBy")
  pushSubscription        PushSubscription?
  refundAttemptsActed     RefundAttempt[]          @relation("RefundAttemptActor")
  reviewModerationActions ReviewModerationLog[]    @relation("ReviewModerationActor")
  reviewReplies           ReviewReply[]
  reviews                 Review[]
  savedTrips              SavedTrip[]
  staffInvitationAccepted StaffInvitation[]        @relation("StaffInvitationAccepted")
  staffInvitationsCreated StaffInvitation[]        @relation("StaffInvitationCreator")
  systemConfigs           SystemConfig[]
  tripExecutionOperations TripExecutionOperation[]
  tripExecutionSessions   TripExecutionSession[]
  tripPlans               TripPlan[]
  checkins                UserCheckin[]
  grantedPermissions      UserPermission[]         @relation("GrantedPermissions")
  userPermissions         UserPermission[]
  profile                 UserProfile?
  sessions                UserSession[]
  staffBusiness           Business?                @relation("BusinessStaff", fields: [businessId], references: [id])
  businessRole            BusinessRole?            @relation(fields: [businessRoleId], references: [id])
  role                    Role                     @relation(fields: [roleId], references: [id])

  @@index([deletedAt])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique @map("user_id")
  fullName             String?   @map("full_name")
  phone                String?
  avatar               String?
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  gender               String?
  address              String?
  provinceCode         String?   @map("province_code")
  districtCode         String?   @map("district_code")
  bio                  String?
  travelPreferences    Json?     @map("travel_preferences")
  notificationSettings Json      @default("{}") @map("notification_settings")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  nickname             String?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  deviceId     String?  @map("device_id")
  deviceName   String?  @map("device_name")
  ipAddress    String?  @map("ip_address")
  pushToken    String?  @map("push_token")
  isActive     Boolean  @default(true) @map("is_active")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model EmailVerification {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  email          String
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  otpHash        String?   @map("otp_hash")
  otpExpiresAt   DateTime? @map("otp_expires_at")
  otpAttempts    Int       @default(0) @map("otp_attempts")
  otpLockedUntil DateTime? @map("otp_locked_until")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email, otpHash])
  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model SystemConfig {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  value         Json
  description   String?
  updatedBy     Int      @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedByUser User     @relation(fields: [updatedBy], references: [id])

  @@map("system_configs")
}

model ApiKeyManagement {
  id           Int       @id @default(autoincrement())
  serviceName  String    @unique @map("service_name")
  apiKey       String    @map("api_key") @db.Text
  monthlyLimit Int       @default(1000) @map("monthly_limit")
  currentUsage Int       @default(0) @map("current_usage")
  resetDay     Int       @default(1) @map("reset_day")
  status       String    @default("active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  keySuffix    String?   @map("key_suffix")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("api_keys_management")
}

model AiConfig {
  id              Int               @id @default(autoincrement())
  key             String            @unique
  activeVersionId Int?              @unique @map("active_version_id")
  draftVersionId  Int?              @unique @map("draft_version_id")
  status          String            @default("active")
  revision        Int               @default(0)
  updatedBy       Int?              @map("updated_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  versions        AiConfigVersion[] @relation("AiConfigVersions")
  activeVersion   AiConfigVersion?  @relation("ActiveAiConfigVersion", fields: [activeVersionId], references: [id])
  draftVersion    AiConfigVersion?  @relation("DraftAiConfigVersion", fields: [draftVersionId], references: [id])
  updatedByUser   User?             @relation("AiConfigUpdatedBy", fields: [updatedBy], references: [id])

  @@map("ai_configs")
}

model AiConfigVersion {
  id            Int       @id @default(autoincrement())
  aiConfigId    Int       @map("ai_config_id")
  version       Int
  status        String
  configData    Json      @map("config_data")
  changeReason  String    @map("change_reason")
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  aiConfig      AiConfig  @relation("AiConfigVersions", fields: [aiConfigId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("AiConfigVersionCreatedBy", fields: [createdBy], references: [id])
  activeFor     AiConfig? @relation("ActiveAiConfigVersion")
  draftFor      AiConfig? @relation("DraftAiConfigVersion")

  @@unique([aiConfigId, version])
  @@index([aiConfigId, status])
  @@map("ai_config_versions")
}

model AiRequestLog {
  id               Int      @id @default(autoincrement())
  requestId        String   @unique @map("request_id")
  anonymousUserRef String?  @map("anonymous_user_ref")
  feature          String
  provider         String
  model            String
  configVersion    Int?     @map("config_version")
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  latencyMs        Int?     @map("latency_ms")
  status           String
  errorCode        String?  @map("error_code")
  safetyBlocked    Boolean  @default(false) @map("safety_blocked")
  feedback         String?
  feedbackReason   String?  @map("feedback_reason")
  isTest           Boolean  @default(false) @map("is_test")
  createdAt        DateTime @default(now()) @map("created_at")
  expiresAt        DateTime @map("expires_at")

  @@index([createdAt])
  @@index([isTest, createdAt])
  @@index([feature, status, createdAt])
  @@map("ai_request_logs")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  action      String
  tableName   String   @map("table_name")
  recordId    Int      @map("record_id")
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  description String?
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FeedbackReport {
  id           Int       @id @default(autoincrement())
  reporterId   Int?      @map("reporter_id")
  reportType   String    @map("report_type")
  targetType   String?   @map("target_type")
  targetId     Int?      @map("target_id")
  title        String
  content      String
  screenshot   String?
  status       String    @default("pending")
  adminNote    String?   @map("admin_note")
  resolvedBy   Int?      @map("resolved_by")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  reporter     User?     @relation("Reporter", fields: [reporterId], references: [id])
  resolvedUser User?     @relation("Resolver", fields: [resolvedBy], references: [id])

  @@map("feedback_reports")
}

model BannerMarketing {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  imageData     String   @map("image_data")
  linkType      String   @default("none") @map("link_type")
  linkValue     String?  @map("link_value")
  position      String   @default("home")
  priority      Int      @default(0)
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  isActive      Boolean  @default(true) @map("is_active")
  clickCount    Int      @default(0) @map("click_count")
  viewCount     Int      @default(0) @map("view_count")
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")
  createdByUser User     @relation(fields: [createdBy], references: [id])

  @@index([isActive, startDate, endDate, priority])
  @@map("banners_marketing")
}

model NotificationGlobal {
  id            Int                     @id @default(autoincrement())
  title         String
  body          String
  imageUrl      String?                 @map("image_url")
  data          Json?
  targetType    String                  @default("all") @map("target_type")
  targetValue   Json?                   @map("target_value")
  scheduledAt   DateTime?               @map("scheduled_at")
  sentAt        DateTime?               @map("sent_at")
  status        String                  @default("draft")
  successCount  Int                     @default(0) @map("success_count")
  failCount     Int                     @default(0) @map("fail_count")
  createdBy     Int                     @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at")
  readAt        DateTime?               @map("read_at")
  recipients    NotificationRecipient[]
  createdByUser User                    @relation(fields: [createdBy], references: [id])

  @@index([status, targetType, sentAt(sort: Desc)])
  @@map("notifications_global")
}

model NotificationRecipient {
  id             Int                @id @default(autoincrement())
  notificationId Int                @map("notification_id")
  userId         Int                @map("user_id")
  businessId     Int?               @map("business_id")
  roleId         Int?               @map("role_id")
  readAt         DateTime?          @map("read_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  business       Business?          @relation(fields: [businessId], references: [id])
  notification   NotificationGlobal @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt(sort: Desc), createdAt(sort: Desc)])
  @@index([businessId, readAt])
  @@index([roleId, readAt])
  @@map("notification_recipients")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model DistrictCantho {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String       @unique
  latitude    Decimal      @db.Decimal(10, 7)
  longitude   Decimal      @db.Decimal(10, 7)
  boundary    Json?
  description String?
  thumbnail   String?
  isActive    Boolean      @default(true) @map("is_active")
  places      Place[]
  wards       WardCantho[]

  @@map("districts_cantho")
}

model WardCantho {
  id         Int            @id @default(autoincrement())
  districtId Int            @map("district_id")
  name       String
  code       String         @unique
  wardType   String         @map("ward_type")
  latitude   Decimal?       @db.Decimal(10, 7)
  longitude  Decimal?       @db.Decimal(10, 7)
  isActive   Boolean        @default(true) @map("is_active")
  boundary   Json?
  places     Place[]
  district   DistrictCantho @relation(fields: [districtId], references: [id])

  @@unique([districtId, name])
  @@map("wards_cantho")
}

model AdministrativeDatasetRelease {
  id               Int                                    @id @default(autoincrement())
  sourceRepo       String                                 @map("source_repo")
  sourceRef        String                                 @map("source_ref")
  sourceCommit     String                                 @map("source_commit")
  releaseName      String                                 @map("release_name")
  manifestChecksum String                                 @map("manifest_checksum")
  importedAt       DateTime                               @default(now()) @map("imported_at")
  activatedAt      DateTime?                              @map("activated_at")
  isActive         Boolean                                @default(false) @map("is_active")
  wardRecords      AdministrativeWardDatasetRecord[]
  placeExceptions  PlaceAdministrativeLocationException[]
  provinceRecords  ProvinceDatasetRecord[]

  @@unique([sourceRepo, sourceCommit])
  @@map("administrative_dataset_releases")
}

model Province {
  code      String                  @id @db.VarChar(20)
  createdAt DateTime                @default(now()) @map("created_at")
  places    Place[]
  records   ProvinceDatasetRecord[]

  @@map("provinces")
}

model AdministrativeWard {
  code      String                            @id @db.VarChar(20)
  createdAt DateTime                          @default(now()) @map("created_at")
  records   AdministrativeWardDatasetRecord[]
  places    Place[]

  @@map("administrative_wards")
}

model ProvinceDatasetRecord {
  datasetReleaseId    Int                          @map("dataset_release_id")
  provinceCode        String                       @map("province_code") @db.VarChar(20)
  name                String
  nameEn              String?                      @map("name_en")
  fullName            String                       @map("full_name")
  fullNameEn          String?                      @map("full_name_en")
  codeName            String?                      @map("code_name")
  searchName          String                       @map("search_name")
  administrativeType  String                       @map("administrative_type") @db.VarChar(40)
  isActive            Boolean                      @default(true) @map("is_active")
  province_boundaries province_boundaries?
  datasetRelease      AdministrativeDatasetRelease @relation(fields: [datasetReleaseId], references: [id], onDelete: Cascade)
  province            Province                     @relation(fields: [provinceCode], references: [code])

  @@id([datasetReleaseId, provinceCode])
  @@index([datasetReleaseId, isActive])
  @@index([searchName(ops: raw("gist_trgm_ops"))], map: "province_records_search_trgm_idx", type: Gist)
  @@map("province_dataset_records")
}

model AdministrativeWardDatasetRecord {
  datasetReleaseId               Int                             @map("dataset_release_id")
  wardCode                       String                          @map("ward_code") @db.VarChar(20)
  provinceCode                   String                          @map("province_code") @db.VarChar(20)
  name                           String
  nameEn                         String?                         @map("name_en")
  fullName                       String?                         @map("full_name")
  fullNameEn                     String?                         @map("full_name_en")
  codeName                       String?                         @map("code_name")
  searchName                     String                          @map("search_name")
  administrativeType             String                          @map("administrative_type") @db.VarChar(40)
  isActive                       Boolean                         @default(true) @map("is_active")
  administrative_ward_boundaries administrative_ward_boundaries?
  datasetRelease                 AdministrativeDatasetRelease    @relation(fields: [datasetReleaseId], references: [id], onDelete: Cascade)
  ward                           AdministrativeWard              @relation(fields: [wardCode], references: [code])

  @@id([datasetReleaseId, wardCode])
  @@index([datasetReleaseId, provinceCode, isActive], map: "ward_records_release_province_active_idx")
  @@index([searchName(ops: raw("gist_trgm_ops"))], map: "ward_records_search_trgm_idx", type: Gist)
  @@map("administrative_ward_dataset_records")
}

model PlaceAdministrativeLocationException {
  id                 Int                          @id @default(autoincrement())
  placeId            Int                          @map("place_id")
  datasetReleaseId   Int                          @map("dataset_release_id")
  reason             String                       @db.VarChar(40)
  candidateWardCodes String[]                     @default([]) @map("candidate_ward_codes") @db.VarChar(20)
  suggestedWards     Json                         @default("[]") @map("suggested_wards")
  status             String                       @default("open") @db.VarChar(20)
  resolutionNote     String?                      @map("resolution_note")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  datasetRelease     AdministrativeDatasetRelease @relation(fields: [datasetReleaseId], references: [id], onDelete: Cascade)
  place              Place                        @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, datasetReleaseId])
  @@index([datasetReleaseId, status])
  @@map("place_administrative_location_exceptions")
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  slug         String        @unique
  icon         String?
  color        String        @default("#3B82F6")
  description  String?
  thumbnail    String?
  parentId     Int?          @map("parent_id")
  order        Int           @default(0)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  level        Int           @default(1)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")
  categoryTags CategoryTag[]
  places       Place[]

  @@index([slug])
  @@index([level], map: "idx_categories_level")
  @@index([level])
  @@map("categories")
}

model PlaceTag {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  slug          String         @unique
  tagType       String         @default("general") @map("tag_type")
  icon          String?
  color         String         @default("#6B7280")
  usageCount    Int            @default(0) @map("usage_count")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  tagGroupId    Int?           @map("tag_group_id")
  categoryTags  CategoryTag[]
  tagGroup      TagGroup?      @relation(fields: [tagGroupId], references: [id], onDelete: Restrict)
  placeTagLinks PlaceTagLink[]

  @@index([tagGroupId], map: "idx_place_tags_tag_group_id")
  @@map("place_tags")
}

model TagGroup {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  nameVi    String     @map("name_vi")
